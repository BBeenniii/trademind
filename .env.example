POSTGRES_USER=trademind
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_DB=trademind
POSTGRES_PORT=55432

DATABASE_URL=postgresql://trademind:YOUR_POSTGRES_PASSWORD_HERE@localhost:55432/trademind?schema=public
API_PORT=3000
FRONTEND_PORT=5173
ML_SERVICE_URL=http://127.0.0.1:8000

OPENAI_API_KEY=[YOUR_OPENAI_API_KEY_HERE]
OPENAI_MODEL=gpt-4o-mini
DISCORD_WEBHOOK_URL=[YOUR_DISCORD_WEBHOOK_URL_HERE]

LIVE_MARKET_PROVIDER=mock
LIVE_PAIR=EURUSD

FINNHUB_API_KEY=[YOUR_FINNHUB_API_KEY_HERE]
FINNHUB_SYMBOL=OANDA:EUR_USD
POLYGON_API_KEY=[YOUR_POLYGON_API_KEY_HERE]

LIVE_SIGNAL_INTERVAL_SECONDS=60

PAPER_TRADING_ENABLED=true
PAPER_STARTING_BALANCE=10000
PAPER_TRADE_SIZE=1000
PAPER_MIN_CONFIDENCE=0.65
PAPER_STOP_LOSS_PCT=0.004
PAPER_TAKE_PROFIT_PCT=0.008

MODEL_RETRAIN_MIN_FEEDBACK=25
MODEL_AUTO_PROMOTE=false
MODEL_RETRAIN_SCHEDULE_ENABLED=false

TRAINING_TIMEFRAME=5m
PREDICTION_HORIZON=3
BUY_THRESHOLD=0.0003
SELL_THRESHOLD=-0.0003
MODEL_TRAINING_MAX_ROWS=180000
ONLINE_LEARNING_ENABLED=true
ONLINE_LEARNING_MIN_FEEDBACK=10